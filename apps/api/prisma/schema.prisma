// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  ownedWorkspaces     Workspace[]       @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  uploadedMeetings    Meeting[]         @relation("MeetingUploader")
  assignedActionItems ActionItem[]      @relation("ActionItemAssignee")
}

/// One row per issued refresh token. We store only a SHA-256 hash of the token,
/// never the token itself, so a DB leak can't be replayed. `revokedAt` powers
/// logout and rotation (an old token is revoked the moment a new one is issued).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

/// A collaborative workspace. Meetings live inside a workspace, and access to
/// everything below a meeting (transcript, summary, action items) is gated on
/// the requester being a member of the owning workspace.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  meetings Meeting[]

  @@index([ownerId])
}

/// Join row between a User and a Workspace, carrying the member's role.
/// The owner also gets an OWNER membership row so membership checks have a
/// single source of truth.
model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum MeetingStatus {
  UPLOADED
  PROCESSING
  TRANSCRIBED
  SUMMARIZED
  FAILED
}

/// An uploaded meeting recording plus its processing state. The raw file is not
/// stored in the DB — only a `storageKey` pointing at the StorageService
/// backend (local disk for now, S3 later).
model Meeting {
  id           String        @id @default(uuid())
  workspaceId  String
  uploadedById String
  title        String
  description  String?
  status       MeetingStatus @default(UPLOADED)

  // Stored-file metadata (the bytes live in the storage backend).
  storageKey   String
  originalName String
  mimeType     String
  fileSize     Int
  durationSec  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation("MeetingUploader", fields: [uploadedById], references: [id])
  transcript  Transcript?
  summary     Summary?
  actionItems ActionItem[]

  @@index([workspaceId])
}

/// Generic state machine shared by the async AI artifacts (transcript, summary).
/// PENDING is the initial state written when work is requested; an AI worker
/// (wired later) flips it to PROCESSING → COMPLETED / FAILED.
enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Transcript {
  id        String           @id @default(uuid())
  meetingId String           @unique
  status    ProcessingStatus @default(PENDING)
  language  String?
  text      String?
  segments  Json?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Summary {
  id        String           @id @default(uuid())
  meetingId String           @unique
  status    ProcessingStatus @default(PENDING)
  content   String?
  model     String?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// A task extracted from a meeting. Can be created by the AI extraction step
/// (later) or manually by a workspace member.
model ActionItem {
  id         String           @id @default(uuid())
  meetingId  String
  content    String
  assigneeId String?
  dueDate    DateTime?
  status     ActionItemStatus @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assigneeId])
}