# Copy to .env and fill in. All variables are validated on boot (see src/common/config/env.validation.ts).

NODE_ENV="development"
PORT=4000

# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_meeting_assistant?schema=public"

# JWT — secret must be at least 16 characters
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
