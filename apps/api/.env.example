# Copy to .env and fill in. All variables are validated on boot (see src/common/config/env.validation.ts).

NODE_ENV="development"
PORT=4000

# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_meeting_assistant?schema=public"

# JWT — secrets must be at least 16 characters
# Access token: short-lived, sent in the response body / Authorization header.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1h"
# Refresh token: long-lived, stored hashed in the DB and delivered as an httpOnly cookie.
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# File storage — local disk for now (S3 later). Directory is relative to the API cwd.
STORAGE_LOCAL_DIR="./storage"
# Max meeting upload size in megabytes.
MAX_UPLOAD_SIZE_MB=1024
